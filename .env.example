# DriveMatch server environment — copy this file to ".env" and fill it in.
# ".env" is git-ignored and must never be committed. The browser never sees these values.

# --- Muse Wonder (Meta) ---
# Paste your API token here:
LLM_API_KEY=
# Endpoint base or full endpoint. Examples of the two supported shapes:
#   https://<your-endpoint>/v1                 (Chat Completions style)
#   https://<your-endpoint>/v1/responses       (Responses style)
LLM_BASE_URL=
LLM_MODEL=muse-wonder-1.0
LLM_PROVIDER_MODEL=meta/muse-wonder-1.0
# auto | chat | responses  ("auto" infers from a /responses endpoint URL)
LLM_API_STYLE=auto
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=900
LLM_TIMEOUT_MS=30000

# --- Search grounding for vehicle analysis (no vehicle database) ---
# auto picks Tavily when SEARCH_API_KEY is set, otherwise uses a
# DuckDuckGo HTML fallback suitable for development.
SEARCH_PROVIDER=auto
# Recommended for production reliability: a Tavily, Brave or Serper key.
SEARCH_API_KEY=
# Optional override of the search provider's base URL:
SEARCH_API_BASE_URL=
SEARCH_TIMEOUT_MS=12000

# Stable-facts cache DB (SQLite): trims/colours/options/specs are cached
# per vehicle and refreshed after this TTL (~monthly). Pricing,
# sentiment and common issues are never cached — always pulled live.
VEHICLE_CACHE_DB=data/vehicle-cache.db
VEHICLE_STABLE_CACHE_TTL_MS=2592000000
VEHICLE_MAX_TOKENS=12000
# Leaner token budget for the live-only update on a cache hit:
VEHICLE_LIVE_MAX_TOKENS=5000
VEHICLE_LLM_TIMEOUT_MS=180000
# Reasoning effort for grounded synthesis (Responses API): minimal|low|medium|high
VEHICLE_REASONING_EFFORT=medium
VEHICLE_CACHE_TTL_MS=3600000
# Set true only if your Muse Wonder endpoint natively supports a
# web-search tool; LLM_WEB_SEARCH_TOOL is the tool type it expects.
LLM_NATIVE_GROUNDING=false
LLM_WEB_SEARCH_TOOL=web_search

# --- Server ---
PORT=5173
AGENT_NAME=Maya
